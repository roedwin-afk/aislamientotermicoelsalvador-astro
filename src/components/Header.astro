---
import MobileMenu from './MobileMenu.tsx';
import { CONTACT, waLink } from '../lib/site-config';

const NAV_LINKS = [
  { href: '/', label: 'Inicio' },
  { href: '#productos', label: 'Nuestros Productos' },
  { href: '#proyectos', label: 'Aplicaciones' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '/blog', label: 'Blog' },
  { href: '#contacto', label: 'Contáctanos' },
];

const whatsappHref = waLink('Hola, deseo solicitar una cotización de aislamiento térmico.');
---

<div class="bg-brand-dark text-slate-300 text-xs py-2 px-4 border-b border-slate-800 hidden sm:block">
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    <div class="flex items-center space-x-6">
      <span class="flex items-center gap-2">
        <i class="fa-solid fa-certificate text-brand-red"></i>
        <span>Distribuidor Oficial <strong>Owens Corning</strong> para El Salvador y CA</span>
      </span>
      <span class="flex items-center gap-2">
        <i class="fa-solid fa-clock text-slate-400"></i>
        <span>Lun - Vie: 8:00 AM - 5:00 PM</span>
      </span>
    </div>
    <div class="flex items-center space-x-4">
      <a href={CONTACT.phoneHref} class="hover:text-white transition flex items-center gap-1">
        <i class="fa-solid fa-phone text-brand-red"></i> {CONTACT.phone}
      </a>
      <span class="text-slate-600">|</span>
      <a href={`mailto:${CONTACT.email}`} class="hover:text-white transition flex items-center gap-1">
        <i class="fa-solid fa-envelope text-slate-400"></i> {CONTACT.email}
      </a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="flex items-center bg-brand-dark rounded-lg px-4 py-2.5">
        <img src="/logo-promaica-blanco.png" alt="PROMAICA" class="h-9 w-auto object-contain" />
      </a>

      <nav class="hidden lg:flex items-center space-x-8 text-sm font-medium text-slate-700">
        {NAV_LINKS.map((link) => (
          <a href={link.href} class="hover:text-brand-red transition">{link.label}</a>
        ))}
      </nav>

      <div class="hidden sm:flex items-center">
        
        <a  href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-green-600 hover:bg-green-700 text-white font-medium text-sm transition shadow-sm hover:shadow-md"
        >
          <i class="fa-brands fa-whatsapp text-lg"></i>
          <span>Quiero cotizar</span>
        </a>
      </div>

      <MobileMenu client:load links={NAV_LINKS} whatsappHref={whatsappHref} />
    </div>
  </div>
</header>