---
import { CONTACT, SOCIAL_LINKS, LOCATIONS } from '../lib/site-config';

const currentYear = new Date().getFullYear();
---

<footer id="contacto" class="bg-brand-dark text-slate-400 text-sm pt-16 pb-8 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">

      <!-- Columna 1: Logo & Resumen -->
      <div class="lg:col-span-2 space-y-4">
        <div class="inline-block bg-white rounded-lg px-4 py-2.5">
          <img src="/logo-promaica-blanco.png" alt="PROMAICA" class="h-9 w-auto object-contain invert" />
        </div>
        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          Especialistas en asesoría y suministro de materiales de aislamiento térmico y acústico en El Salvador y Centroamérica. Distribuidor autorizado Owens Corning.
        </p>
      </div>

      <!-- Columna 2: Navegación Rápida -->
      <div class="space-y-3">
        <h4 class="text-white font-bold text-sm uppercase tracking-wider">Menú Principal</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#inicio" class="hover:text-white transition">Inicio</a></li>
          <li><a href="#productos" class="hover:text-white transition">Nuestros Productos</a></li>
          <li><a href="#proyectos" class="hover:text-white transition">Aplicaciones por Proyecto</a></li>
          <li><a href="#nosotros" class="hover:text-white transition">Por Qué Elegirnos</a></li>
          <li><a href="#blog" class="hover:text-white transition">Blog & Artículos</a></li>
        </ul>
      </div>

      <!-- Columna 3: Contacto y Sedes -->
      <div class="space-y-3">
        <h4 class="text-white font-bold text-sm uppercase tracking-wider">Contacto</h4>
        <ul class="space-y-2 text-xs">
          <li class="flex items-center gap-2">
            <i class="fa-solid fa-phone text-brand-red"></i>
            <span>{CONTACT.phone}</span>
          </li>
          <li class="flex items-center gap-2">
            <i class="fa-solid fa-envelope text-slate-400"></i>
            <span>{CONTACT.email}</span>
          </li>
          {LOCATIONS.map((loc) => (
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-location-dot text-brand-red mt-0.5"></i>
              <span>{loc.name}: {loc.address}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 4: Redes + Talento Humano -->
      <div class="space-y-4">
        <div>
          <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-3">Síguenos</h4>
          <div class="flex items-center gap-3">
            <a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-brand-red flex items-center justify-center transition">
              <i class="fa-brands fa-facebook"></i>
            </a>
            <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-brand-red flex items-center justify-center transition">
              <i class="fa-brands fa-instagram"></i>
            </a>
            <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-brand-red flex items-center justify-center transition">
              <i class="fa-brands fa-youtube"></i>
            </a>
            <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-brand-red flex items-center justify-center transition">
              <i class="fa-brands fa-linkedin"></i>
            </a>
          </div>
        </div>
        <div>
          <p class="text-xs text-slate-400 mb-2">
            ¿Querés formar parte de nuestro equipo de asesores técnicos e ingenieros?
          </p>
          
         <a   href="mailto:rrhh@promaica.com?subject=Solicitud%20de%20Empleo%20-%20PROMAICA"
            class="inline-flex items-center gap-2 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-xs font-semibold border border-slate-700 transition"
          >
            <i class="fa-solid fa-briefcase text-brand-red"></i>
            <span>Únete a nuestro equipo</span>
          </a>
        </div>
      </div>

    </div>

    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-4">
      <p>© {currentYear} PROMAICA - Todos los derechos reservados. Distribuidor de Aislamiento Térmico en El Salvador.</p>
      <div class="flex space-x-6">
        <a href="#" class="hover:text-slate-400 transition">Términos de Servicio</a>
        <a href="#" class="hover:text-slate-400 transition">Política de Privacidad</a>
      </div>
    </div>

  </div>
</footer>