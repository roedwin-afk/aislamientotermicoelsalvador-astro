---
import { CONTACT, LOCATIONS } from '../lib/site-config';

interface Props {
  showPhoneLine?: boolean;
}
const { showPhoneLine = true } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  {LOCATIONS.map((loc) => (
    <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-4">
      <div class="flex justify-between items-center pb-3 border-b border-slate-700">
        <div>
          <h3 class="text-lg font-bold text-white">Sede {loc.name}</h3>
          <p class="text-xs text-slate-400">{loc.address}</p>
        </div>
        <span
          data-status-badge
          data-schedule={JSON.stringify(loc.schedule)}
          class="px-3 py-1 bg-slate-700 text-slate-300 border border-slate-600 rounded-full text-xs font-semibold flex items-center gap-1.5 shrink-0"
        >
          <span data-status-dot class="w-2 h-2 rounded-full bg-slate-500"></span>
          <span data-status-text>—</span>
        </span>
      </div>

      <div class="relative rounded-xl overflow-hidden border border-slate-600 bg-slate-900">
        <iframe
          src={loc.mapEmbedUrl}
          width="100%"
          height="240"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Mapa de ubicación PROMAICA ${loc.name}`}
        ></iframe>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-300 pt-1">
        {loc.hours.map((h) => (
          <div class="flex items-start gap-2">
            <i class="fa-solid fa-clock text-brand-red mt-0.5"></i>
            <span>{h}</span>
          </div>
        ))}
      </div>

      
      <a  href={loc.mapsUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-xs font-bold text-brand-red hover:underline"
      >
        <i class="fa-solid fa-location-dot"></i>
        <span>Abrir en Google Maps</span>
      </a>
    </div>
  ))}
</div>

{showPhoneLine && (
  <div class="flex items-center gap-2 text-xs text-slate-400 mt-6">
    <i class="fa-solid fa-headset text-brand-red"></i>
    <span>Atención al cliente (ambas sedes): {CONTACT.phone}</span>
  </div>
)}

<script>
  const DAY_KEYS = ['dom', 'lun', 'mar', 'mie', 'jue', 'vie', 'sab'] as const;

  function nowInElSalvador(): Date {
    const svString = new Date().toLocaleString('en-US', { timeZone: 'America/El_Salvador' });
    return new Date(svString);
  }

  function updateBadges() {
    const sv = nowInElSalvador();
    const dayKey = DAY_KEYS[sv.getDay()];
    const hourDecimal = sv.getHours() + sv.getMinutes() / 60;

    document.querySelectorAll<HTMLElement>('[data-status-badge]').forEach((badge) => {
      const schedule = JSON.parse(badge.dataset.schedule || '{}');
      const today = schedule[dayKey];
      const isOpen = !!today && hourDecimal >= today.open && hourDecimal < today.close;

      const dot = badge.querySelector<HTMLElement>('[data-status-dot]');
      const text = badge.querySelector<HTMLElement>('[data-status-text]');
      if (!dot || !text) return;

      if (isOpen) {
        badge.className = 'px-3 py-1 bg-green-900/50 text-green-400 border border-green-700/50 rounded-full text-xs font-semibold flex items-center gap-1.5 flex-shrink-0';
        dot.className = 'w-2 h-2 rounded-full bg-green-400 animate-ping';
        text.textContent = 'Abierto';
      } else {
        badge.className = 'px-3 py-1 bg-red-900/50 text-red-400 border border-red-700/50 rounded-full text-xs font-semibold flex items-center gap-1.5 flex-shrink-0';
        dot.className = 'w-2 h-2 rounded-full bg-red-400';
        text.textContent = 'Cerrado';
      }
    });
  }

  updateBadges();
  setInterval(updateBadges, 60_000);
</script>