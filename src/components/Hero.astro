---
import { waLink } from '../lib/site-config';

const whatsappCtaHref = waLink('Hola, deseo solicitar una cotización de aislamiento térmico.');
---

<section id="inicio" class="relative hero-gradient text-white overflow-hidden py-16 lg:py-24">
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#e31b23_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Columna Izquierda: Mensaje de Valor -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-red/20 border border-brand-red/40 text-brand-red text-xs font-semibold uppercase tracking-wider">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Líderes en Aislamiento en Centroamérica</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-white">
          ¿Buscas soluciones de <span class="text-brand-red">aislamiento térmico</span> y <span class="text-sky-400">aislamiento acústico</span>?
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Llegaste al lugar indicado. Suministramos e instalamos materiales de alto desempeño certificados internacionalmente por <strong>Owens Corning</strong> (fibra de vidrio, poliestireno extruido y lana mineral) para optimizar la eficiencia energética y el confort en El Salvador.
        </p>

        <div class="pt-2 flex flex-wrap justify-center lg:justify-start gap-6 text-sm text-slate-300">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-green-400"></i>
            <span>Ahorro Energético HVAC</span>
          </div>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-green-400"></i>
            <span>Resistencia al Fuego</span>
          </div>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-green-400"></i>
            <span>Soporte Técnico Especializado</span>
          </div>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="#productos" class="px-7 py-3.5 rounded-lg bg-brand-red hover:bg-brand-darkred text-white font-semibold text-center transition shadow-lg shadow-brand-red/30">
            Explorar Materiales
          </a>
          <a href="#proyectos" class="px-7 py-3.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-semibold border border-slate-600 text-center transition">
            Ver Casos por Aplicación
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Formulario de Asesoría -->
      <div class="lg:col-span-5">
        <div class="glass-card rounded-2xl p-6 sm:p-8 text-slate-900 shadow-2xl relative border border-white/20">
          <div class="mb-6 border-b border-slate-200 pb-4">
            <span class="text-xs font-bold text-brand-red uppercase tracking-wider block">Atención Inmediata B2B / B2C</span>
            <h2 class="text-2xl font-bold text-slate-900">Solicitar Asesoría Técnica</h2>
            <p class="text-xs text-slate-600 mt-1">Recibe cotización personalizada y recomendación de materiales para tu obra.</p>
          </div>

          <form id="hero-lead-form" class="space-y-4">
            <div>
              <label for="empresa" class="block text-xs font-semibold text-slate-700 uppercase mb-1">Empresa / Proyecto (Opcional)</label>
              <input type="text" id="empresa" name="empresa" placeholder="Ej: Constructora El Salvador S.A." class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-red focus:border-brand-red text-sm outline-none bg-white" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="nombre" class="block text-xs font-semibold text-slate-700 uppercase mb-1">Nombre completo *</label>
                <input type="text" id="nombre" name="nombre" required placeholder="Ing. Carlos Mendoza" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-red focus:border-brand-red text-sm outline-none bg-white" />
              </div>
              <div>
                <label for="telefono" class="block text-xs font-semibold text-slate-700 uppercase mb-1">Teléfono / WhatsApp *</label>
                <input type="tel" id="telefono" name="telefono" required placeholder="+503 7000-0000" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-red focus:border-brand-red text-sm outline-none bg-white" />
              </div>
            </div>

            <div>
              <label for="correo" class="block text-xs font-semibold text-slate-700 uppercase mb-1">Correo electrónico *</label>
              <input type="email" id="correo" name="correo" required placeholder="carlos@empresa.com" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-red focus:border-brand-red text-sm outline-none bg-white" />
            </div>

            <div>
              <label for="comentario" class="block text-xs font-semibold text-slate-700 uppercase mb-1">¿Qué necesitas aislar? *</label>
              <textarea id="comentario" name="comentario" rows="3" required placeholder="Descríbenos tu requerimiento (ej: aislamiento para techo de nave industrial de 500m², control de ruido en oficinas, etc.)" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-red focus:border-brand-red text-sm outline-none bg-white resize-none"></textarea>
            </div>

            <button type="submit" class="w-full py-3.5 px-6 bg-brand-red hover:bg-brand-darkred text-white font-bold rounded-lg transition shadow-md flex items-center justify-center gap-2 uppercase tracking-wider text-sm">
              <i class="fa-solid fa-paper-plane"></i>
              <span>Enviar solicitud de cotización</span>
            </button>

            <p class="text-[11px] text-slate-500 text-center mt-2">
              Atendemos proyectos en San Salvador, San Miguel y toda Centroamérica.
            </p>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Placeholder de envío — se reemplaza en el paso 8 por la lógica real
  // (correo / CRM / WhatsApp, según definas el destino).
  const form = document.getElementById('hero-lead-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('¡Gracias por comunicarte con PROMAICA! Un asesor técnico se pondrá en contacto a la brevedad.');
    form.reset();
  });
</script>
</script>