---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getPosts, getFeaturedImage, formatWpDate, stripHtml } from '../../lib/wp/client';
import type { WPPost } from '../../lib/wp/types';

const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, Number(pageParam) || 1);

let posts: WPPost[];
let totalPages: number;

try {
  const result = await getPosts(currentPage, 9);
  posts = result.posts;
  totalPages = result.totalPages;
} catch (err) {
  console.error('Error cargando posts de WordPress:', err);
  posts = [];
  totalPages = 0;
}
---

<Layout title="Blog | PROMAICA" description="Artículos técnicos sobre aislamiento térmico y acústico en El Salvador.">
  <main class="py-16 bg-slate-100 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-brand-red font-bold text-xs uppercase tracking-widest block mb-2">Recursos Técnicos</span>
        <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">Blog de PROMAICA</h1>
        <p class="text-slate-600 mt-3 text-base">
          Guías, novedades y consejos técnicos sobre aislamiento térmico y acústico.
        </p>
      </div>

      {posts.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-slate-500">No pudimos cargar los artículos en este momento. Intentá de nuevo más tarde.</p>
        </div>
      ) : (
        <>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {posts.map((post) => {
              const featured = getFeaturedImage(post);
              return (
                
                <a  href={`/blog/${post.slug}`}
                  class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition border border-slate-200 flex flex-col group"
                >
                  {featured && (
                    <img
                      src={featured.url}
                      alt={featured.alt}
                      class="w-full h-48 object-cover group-hover:scale-105 transition duration-500"
                      loading="lazy"
                    />
                  )}
                  <div class="p-6 flex-1 flex flex-col">
                    <span class="text-xs text-slate-400 mb-2">{formatWpDate(post.date)}</span>
                    <h2
                      class="text-lg font-bold text-slate-900 group-hover:text-brand-red transition mb-2"
                      set:html={post.title.rendered}
                    />
                    <p class="text-sm text-slate-600 line-clamp-3">
                      {stripHtml(post.excerpt.rendered)}
                    </p>
                  </div>
                </a>
              );
            })}
          </div>

          {totalPages > 1 && (
            <div class="flex justify-center items-center gap-4 mt-12">
              {currentPage > 1 && (
                
                <a  href={`/blog?page=${currentPage - 1}`}
                  class="px-5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-700 text-sm font-semibold hover:border-brand-red hover:text-brand-red transition"
                >
                  ← Anterior
                </a>
              )}
              <span class="text-sm text-slate-500">Página {currentPage} de {totalPages}</span>
              {currentPage < totalPages && (
                
                <a  href={`/blog?page=${currentPage + 1}`}
                  class="px-5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-700 text-sm font-semibold hover:border-brand-red hover:text-brand-red transition"
                >
                  Siguiente →
                </a>
              )}
            </div>
          )}
        </>
      )}
    </div>
  </main>
</Layout>