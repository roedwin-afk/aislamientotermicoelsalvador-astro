---
import Layout from '../layouts/Layout.astro';
import Clientes from '../components/Clientes.astro';

const VALORES = [
  {
    icon: 'fa-award',
    titulo: 'Calidad Certificada',
    desc: 'Solo trabajamos con materiales Owens Corning respaldados por normas internacionales como ASTM y UL.',
  },
  {
    icon: 'fa-user-gear',
    titulo: 'Asesoría Técnica Real',
    desc: 'No solo vendemos material: calculamos el espesor y el sistema correcto para cada proyecto específico.',
  },
  {
    icon: 'fa-map-location-dot',
    titulo: 'Cobertura Regional',
    desc: 'Despachamos a todo El Salvador y damos soporte a proyectos en Centroamérica.',
  },
  {
    icon: 'fa-handshake',
    titulo: 'Compromiso a Largo Plazo',
    desc: 'Acompañamos al cliente desde la cotización hasta después de la instalación.',
  },
];
---

<Layout title="Nosotros | PROMAICA" description="Conocé la historia de PROMAICA, distribuidor oficial Owens Corning de aislamiento térmico y acústico en El Salvador.">

  <!-- Hero con video -->
  <section class="relative hero-gradient text-white py-16 lg:py-20 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#e31b23_1px,transparent_1px)] bg-size-[24px_24px]"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 space-y-4 text-center lg:text-left">
          <span class="text-brand-red font-bold text-xs uppercase tracking-widest block">Conócenos</span>
          <h1 class="text-3xl sm:text-4xl font-extrabold">¿Quiénes somos?</h1>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-lg mx-auto lg:mx-0">
            Especialistas salvadoreños en aislamiento térmico y acústico, distribuidores oficiales de Owens Corning, con más de 1000 proyectos suministrados en San Salvador, San Miguel y toda Centroamérica.
          </p>
        </div>

        <div class="lg:col-span-6">
          <div class="rounded-2xl overflow-hidden shadow-2xl aspect-video border border-white/10">
            <iframe
              class="w-full h-full"
              src="https://www.youtube.com/embed/Su8reQwk-aM"
              title="Instalación de Aislamiento Térmico MBI en Plaza Larista, El Salvador"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-5 text-slate-700 text-base leading-relaxed">
        <p>
          <strong>PROMAICA</strong> es una empresa salvadoreña especializada en el asesoramiento y suministro de aislamientos térmicos y acústicos de la marca Owens Corning, con certificaciones y cumplimiento de estándares internacionales de seguridad.
        </p>
        <p>
          Acompañamos a nuestros clientes desde la selección del material hasta la asesoría técnica para que puedan instalarlo de manera correcta.
        </p>
        <p>
          Brindamos soluciones industriales, comerciales y residenciales para maximizar la eficiencia energética de cada proyecto, con presencia en San Salvador y San Miguel y despacho a todo El Salvador y Centroamérica.
        </p>
      </div>

      <!-- Misión y Visión -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 max-w-4xl">
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
          <div class="w-12 h-12 rounded-xl bg-brand-red/10 text-brand-red flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-bullseye"></i>
          </div>
          <h2 class="font-heading text-xl font-bold text-slate-900 mb-2">Misión</h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Brindar soluciones de aislamiento térmico y acústico de la más alta calidad, respaldadas por materiales certificados internacionalmente, acompañando a nuestros clientes desde la selección del material hasta su correcta instalación.
          </p>
        </div>
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
          <div class="w-12 h-12 rounded-xl bg-brand-red/10 text-brand-red flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-eye"></i>
          </div>
          <h2 class="font-heading text-xl font-bold text-slate-900 mb-2">Visión</h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Ser el aliado estratégico líder en aislamiento térmico y acústico en El Salvador y Centroamérica, reconocidos por la calidad de nuestros materiales y el respaldo técnico de nuestro equipo.
          </p>
        </div>
      </div>

      <!-- Valores -->
      <div class="mt-14">
        <h2 class="font-heading text-xl font-bold text-slate-900 mb-6">Nuestros Valores</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {VALORES.map((v) => (
            <div class="p-5 rounded-xl bg-slate-50 border border-slate-100">
              <div class="w-10 h-10 rounded-lg bg-brand-red/10 text-brand-red flex items-center justify-center text-lg mb-3">
                <i class={`fa-solid ${v.icon}`}></i>
              </div>
              <h3 class="font-bold text-slate-900 text-sm mb-1">{v.titulo}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Clientes />
</Layout>